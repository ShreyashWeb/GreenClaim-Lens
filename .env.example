# Environment Variables Template
# Copy to .env.local for local development. Never commit real keys.

# LLM Providers Configuration (Free tiers: Gemini, Groq, Mistral, HuggingFace, etc.)
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloudflare Turnstile (Anti-abuse protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Bindings (if running local worker emulation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# App Configuration
NEXT_PUBLIC_API_URL=http://localhost:8787/v1
PORT=3000
